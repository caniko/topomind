{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/caniko/topomind/schemas/changeset/changeset.schema.json",
  "title": "Topomind ChangeSet",
  "type": "object",
  "required": ["schema_version", "request_id", "session", "document", "base_revision", "operations", "validate", "idempotency_key"],
  "properties": {
    "schema_version": {"const": "changeset/1.0"},
    "request_id": {"type": "string"},
    "session": {"type": "string"},
    "document": {"type": "string"},
    "base_revision": {"type": "string"},
    "description": {"type": ["string", "null"]},
    "preconditions": {"type": "array", "items": {"$ref": "https://github.com/caniko/topomind/schemas/changeset/precondition.schema.json"}},
    "operations": {"type": "array", "minItems": 1, "items": {"$ref": "https://github.com/caniko/topomind/schemas/changeset/operation.schema.json"}},
    "validate": {"type": "array", "items": {"type": "string"}},
    "idempotency_key": {"type": "string"},
    "approval_token": {"type": ["string", "null"]}
  }
}
