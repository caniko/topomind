{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/caniko/topomind/schemas/policy/workspace.schema.json",
  "title": "Signed Workspace Policy",
  "type": "object",
  "required": ["schema_version", "workspace_id", "document_prefix", "allowed_operations", "max_risk", "signature"],
  "properties": {
    "schema_version": {"const": "policy/1.0"},
    "workspace_id": {"type": "string", "minLength": 1},
    "document_prefix": {"type": "string"},
    "allowed_operations": {"type": "array", "items": {"type": "string", "pattern": "^[a-z_]+$"}},
    "max_risk": {"enum": ["ui", "low", "medium", "high"]},
    "signature": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
